# Copy to .env and fill in. .env is git-ignored.

# "offline" = deterministic rule-based agents, no API key needed.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Langfuse tracing + prompt management (optional; disabled when keys are empty).
# Project settings -> API keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region by default; US region is https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

SEED_CORPUS_DIR=corpus
