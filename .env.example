# Copy to .env and fill in. .env is git-ignored.

# google | anthropic | offline ("offline" = deterministic rule-based agents, no key needed)
LLM_PROVIDER=google

# Gemini: free API key at https://aistudio.google.com (Get API key)
GOOGLE_API_KEY=
# Free-tier quotas are a few requests per minute; the client throttles itself.
LLM_REQUESTS_PER_MINUTE=8

# Claude (paid API): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional per-role model overrides (default: gemini-2.5-flash / claude-opus-5-5)
# MODEL_ROUTER=
# MODEL_ANSWER=
# MODEL_CRITIC=
# MODEL_JUDGE=

# Langfuse tracing + prompt management (optional; disabled when keys are empty).
# Project settings -> API keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region by default; US region is https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

SEED_CORPUS_DIR=corpus
